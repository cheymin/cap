# Cap Netlify 部署所需环境变量

# 管理员密钥（至少 12 个字符，用于登录管理面板）
ADMIN_KEY=your-super-secret-admin-key-at-least-12-chars

# Supabase 数据库连接字符串
# 通过 Netlify Supabase 扩展自动注入以下变量:
#   SUPABASE_DATABASE_URL  ← 数据库连接字符串（自动读取）
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_ANON_KEY
#   SUPABASE_JWT_SECRET
#
# 也可以手动设置 DATABASE_URL
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# 可选：CORS 允许的来源（逗号分隔，* 或留空表示允许所有）
# CORS_ORIGIN=https://example.com,https://app.example.com

# 可选：RSW 密钥位数（默认 2048）
# RSW_BITS=2048

# 可选：Demo 模式（无需鉴权，仅用于演示）
# DEMO_MODE=false

# 可选：自定义 IP 获取的 header
# RATELIMIT_IP_HEADER=X-Forwarded-For
